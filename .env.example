# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini (server-side; required for AI recipe + video detection + ranking)
GEMINI_API_KEY=your-gemini-api-key
# Optional fallback key if the primary key hits quota
GEMINI_API_KEY_FALLBACK=
# Optional browser key used only for client-side image generation flows
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key

# Spoonacular (required for /api/recipes/recommend candidate search)
SPOONACULAR_API_KEY=your-spoonacular-api-key

# USDA FoodData Central (optional; used when Spoonacular nutrition is incomplete)
USDA_API_KEY=your-usda-api-key

# Redis (optional; enables shared caching. Without it, an in-memory cache is used)
REDIS_URL=
